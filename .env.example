# ---------------------------------------------------------------------------
# Signal Room — environment (set real values in the Vercel dashboard, §12)
# Supabase project ycadmmngkdhvpcsrcuaq ("Faraday") is shared with
# Jurisdiction Watch. Every key below must belong to THAT project: a key whose
# JWT `ref` is any other project fails with "Invalid API key" on every query.
# The cold-start log line `[signal-room] config` prints serviceKeyProjectRef
# and serviceKeyRefMatchesUrl so a wrong-project key is visible at a glance.
# ---------------------------------------------------------------------------

# --- Required for the live feed (/signal-room and /api/signal-room/health) ---

# Public (browser-safe). Do NOT mark NEXT_PUBLIC_* variables "Sensitive" in
# Vercel — they are inlined at build time and Sensitive values are not exposed
# to the build.
NEXT_PUBLIC_SUPABASE_URL=https://ycadmmngkdhvpcsrcuaq.supabase.co

# Feature flag — hides the Preview banner. Must be the literal string "true".
# Launch gates: FAR-44 / FAR-46 / FAR-16.
NEXT_PUBLIC_SIGNAL_ROOM_LIVE=false

# Server-only (never exposed to the browser). service_role key of the Faraday
# project. Mark Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required for the configurator APIs (configurations / activate / preview) ---

# Public anon (or sb_publishable_…) key of the Faraday project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required only when the delivery sweep is switched on (P5) ---

# Shared secret the scheduler sends as the x-sweep-secret header.
# /api/signal-room/sweep returns 503 until this is set.
SWEEP_SECRET=

# Email rail. Without RESEND_API_KEY the digest is a log-only no-op.
RESEND_API_KEY=
# Optional — defaults to signals@faraday-intelligence.ai (a verified domain).
# RESEND_FROM_ADDRESS=

# Optional — origin used for the "see all in Signal Room" digest link.
# Defaults to https://faraday-signal-room.com
# SIGNAL_ROOM_URL=
